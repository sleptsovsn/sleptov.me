# Example .env for the controller (controller/.env)
# Copy this file to .env and fill in the secrets before running the controller.
# Keep the .env file out of version control and restrict filesystem permissions (chmod 600).

# Shared auth token that agents will use in the Authorization header (Bearer <TOKEN>)
TOKEN=supersecret-agent-token

# GitHub personal access token (fine-grained or classic). Grant minimal permissions:
# - Repository access: Only select repositories -> sleptsovsn/sleptov.me
# - Permissions: Issues -> Read & write; Metadata -> Read-only
# Paste the token here (do NOT commit it to the repo).
GITHUB_TOKEN=ghp_xxx_replace_me

# The repository where the controller will create issues for approval
GITHUB_REPO=sleptsovsn/sleptov.me

# Public/base URL for links in issue bodies (replace with your controller reachable address)
BASE_URL=http://192.168.12.151:8000

# Poll interval (seconds) for checking GitHub issue comments
POLL_COMMENTS_INTERVAL=15

# Optional: adjust log level
LOG_LEVEL=INFO
